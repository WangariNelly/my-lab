# Copy to .env (git-ignored) and fill in as each week needs it.
# Endpoints and ids only — load real secrets per session from your password
# manager or `aws sso login` / `az login` / `gcloud auth login`.

# --- General
OWNER=your-handle
AWS_REGION=eu-west-1
AWS_PROFILE=opslab-admin

# --- ServiceNow PDI (W01+)
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=opslab.integration
SN_PASSWORD=

# --- Observability (C3/W24+)
PROM_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ES_URL=https://localhost:9200
TEMPO_URL=http://localhost:3200

# --- Dynatrace (W30+, trial)
DT_ENV_URL=https://abc12345.live.dynatrace.com
# One token per purpose (dynatrace/README.md): DT_API_TOKEN is READ-ONLY (entities.read, metrics.read, problems.read).
DT_API_TOKEN=
# Monaco deploy token (write scopes) and S1 rulebook token (problems.read+write): export in the shell, do not store here.
DT_MONACO_TOKEN=
DT_EDA_TOKEN=

# --- AI (C1+, optional until C5)
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_KEY=
